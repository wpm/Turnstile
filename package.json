{
  "name": "turnstile",
  "version": "1.0.0",
  "description": "Turnstile — a Lean proof assistant pairing formal proofs with prose",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "tauri": "tauri",
    "brand:assets": "python3 brand/generate.py",
    "test:e2e": "playwright install chromium && playwright test",
    "test:lean-server": "vitest run --project lean-server",
    "verify": "pnpm run test && pnpm run check && pnpm run lint && pnpm run format:check && pnpm run verify:rust && pnpm run test:e2e && pnpm run test:lean-server",
    "verify:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "marked": "^18.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "katex": "^0.16.45",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
